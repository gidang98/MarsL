{
  "name": "marsl",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node server.js",
    "test:verbose": "node --test --test-reporter=spec tests/*.test.js",
    "test:balance": "node --test tests/balance.test.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:rollback": "node scripts/migrate.js down",
    "migrate:create": "node scripts/migrate.js create",
    "security:audit": "node scripts/security-audit.js",
    "security:check": "npm audit && node scripts/security-audit.js",
    "backup": "node scripts/backup.js create",
    "backup:status": "node scripts/backup.js status",
    "backup:list": "node scripts/backup.js list",
    "restore": "node scripts/restore.js",
    "docker:build": "docker build -t marsl .",
    "docker:run": "docker run -p 3000:3000 -v $(pwd)/data:/app/data marsl",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-slow-down": "^3.1.1",
    "helmet": "^8.3.0",
    "ws": "^8.22.2"
  }
}
